# Certificate status: pki/cert/:serial, which also serves cert/ca and cert/ca_chain.
path "${pki_mount}/cert/*" {
  capabilities = ["read"]
}

path "${pki_mount}/certs/revoked" {
  capabilities = ["list"]
}

path "${pki_mount}/revoke" {
  capabilities = ["update"]
}

# not_after is denied on both signing paths: Vault and OpenBao do not check it against the role's max_ttl.
path "${pki_mount}/sign/ocsp-signer" {
  capabilities = ["update"]
  denied_parameters = {
    "not_after" = []
  }
}

# Federator CSRs and bootstrap certificates.
path "${pki_mount}/sign/default-role" {
  capabilities = ["update"]
  denied_parameters = {
    "not_after" = []
  }
}

# The OCSP signer key. Automated renewal will also need create and update on this path.
path "${kv_mount}/data/${ocsp_signer_kv_path}" {
  capabilities = ["read"]
}

# The default policy is disabled, so tokens need these to renew themselves.
path "auth/token/renew-self" {
  capabilities = ["update"]
}

path "auth/token/lookup-self" {
  capabilities = ["read"]
}
