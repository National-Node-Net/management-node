    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Every OCSP answer is binary DER: decode it here and show the result in Test Results and the Visualize tab.",
                    "var contentType = pm.response.headers.get('Content-Type') || '';",
                    "if (contentType.indexOf('application/ocsp-response') === 0) {",
                    "    var s = ocspSummary(pm.response.stream);",
                    "    console.log('OCSP', s);",
                    "    pm.test('OCSP responseStatus = ' + s.responseStatus, function () { pm.expect(s.responseStatus).to.eql('successful'); });",
                    "    pm.test('certStatus = ' + s.certStatus + (s.revocationReason ? ' (' + s.revocationReason + ')' : ''), function () {});",
                    "    var expected = pm.collectionVariables.get('serial');",
                    "    var norm = function (x) { return String(x || '').replace(/[:-]/g, '').toLowerCase().replace(/^0+/, ''); };",
                    "    if (expected && s.serial) {",
                    "        var same = norm(expected) === norm(s.serial);",
                    "        pm.test(same ? 'asked about the certificate from 1.2 (serial ' + expected + ')'",
                    "                     : 'ocsp-req.der is for serial ' + s.serial + ', not ' + expected + ' from 1.2: run node_files in the terminal',",
                    "            function () { pm.expect(same).to.eql(true); });",
                    "    }",
                    "    var colour = s.certStatus === 'good' ? '#1a7f37' : (s.certStatus === 'revoked' ? '#cf222e' : '#9a6700');",
                    "    pm.visualizer.set(",
                    "        '<style>body{font-family:sans-serif} td{padding:4px 12px;border-bottom:1px solid #ddd} td:first-child{color:#666}</style>' +",
                    "        '<p style=\"color:#666\">The raw body is binary DER (RFC 6960). Decoded by the collection test script:</p>' +",
                    "        '<h2 style=\"color:{{colour}}\">certStatus: {{s.certStatus}}{{#if s.revocationReason}} ({{s.revocationReason}}){{/if}}</h2>' +",
                    "        '<table>' +",
                    "        '<tr><td>responseStatus</td><td>{{s.responseStatus}}</td></tr>' +",
                    "        '<tr><td>serial</td><td>{{s.serial}}</td></tr>' +",
                    "        '{{#if s.revocationTime}}<tr><td>revocationTime</td><td>{{s.revocationTime}}</td></tr>{{/if}}' +",
                    "        '<tr><td>producedAt</td><td>{{s.producedAt}}</td></tr>' +",
                    "        '<tr><td>thisUpdate</td><td>{{s.thisUpdate}}</td></tr>' +",
                    "        '<tr><td>nextUpdate</td><td>{{s.nextUpdate}}</td></tr>' +",
                    "        '</table>',",
                    "        { s: s, colour: colour });",
                    "}",
                    "",
                    "function ocspSummary(b) {",
                    "    function tlv(o) {",
                    "        var tag = b[o], len = b[o + 1], h = 2;",
                    "        if (len & 0x80) { var n = len & 0x7f; len = 0; for (var i = 0; i < n; i++) len = len * 256 + b[o + 2 + i]; h = 2 + n; }",
                    "        return { tag: tag, start: o + h, end: o + h + len };",
                    "    }",
                    "    function kids(t) { var r = [], o = t.start; while (o < t.end) { var c = tlv(o); r.push(c); o = c.end; } return r; }",
                    "    function str(t) { var s = ''; for (var i = t.start; i < t.end; i++) s += String.fromCharCode(b[i]); return s; }",
                    "    var REASONS = { 0: 'unspecified', 1: 'keyCompromise', 2: 'cACompromise', 3: 'affiliationChanged', 4: 'superseded', 5: 'cessationOfOperation', 6: 'certificateHold' };",
                    "    var STATUS = { 0: 'successful', 1: 'malformedRequest', 2: 'internalError', 3: 'tryLater', 5: 'sigRequired', 6: 'unauthorized' };",
                    "    var top = kids(tlv(0));",
                    "    var result = { responseStatus: STATUS[b[top[0].start]] };",
                    "    if (top.length < 2) return result;",
                    "    var bytes = kids(kids(top[1])[0]);",
                    "    var basic = kids(tlv(bytes[1].start));",
                    "    var tbs = kids(basic[0]);",
                    "    var i = tbs[0].tag === 0xa0 ? 1 : 0;",
                    "    result.producedAt = str(tbs[i + 1]);",
                    "    var single = kids(kids(tbs[i + 2])[0]);",
                    "    var serial = '';",
                    "    var certId = kids(single[0]);",
                    "    for (var k = certId[3].start; k < certId[3].end; k++) serial += ('0' + b[k].toString(16)).slice(-2) + ':';",
                    "    result.serial = serial.replace(/^00:/, '').slice(0, -1);",
                    "    var st = single[1];",
                    "    if (st.tag === 0x80) result.certStatus = 'good';",
                    "    else if (st.tag === 0x82) result.certStatus = 'unknown';",
                    "    else {",
                    "        result.certStatus = 'revoked';",
                    "        var rv = kids(st);",
                    "        result.revocationTime = str(rv[0]);",
                    "        if (rv[1]) result.revocationReason = REASONS[b[kids(rv[1])[0].start]];",
                    "    }",
                    "    result.thisUpdate = str(single[2]);",
                    "    if (single[3] && single[3].tag === 0xa0) result.nextUpdate = str(kids(single[3])[0]);",
                    "    return result;",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "0. Setup (once, before the demo)",
            "description": "Reads the client secrets of FEDERATOR_ENV and management-node from the local Keycloak admin API. Fill kcAdminUser / kcAdminPassword (collection variables, current value) from docker/keycloak/.env first.",
            "item": [
                {
                    "name": "0.1 Keycloak admin token",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200', function () { pm.response.to.have.status(200); });",
                                    "pm.collectionVariables.set('kcAdminToken', pm.response.json().access_token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "grant_type",
                                    "value": "password"
                                },
                                {
                                    "key": "client_id",
                                    "value": "admin-cli"
                                },
                                {
                                    "key": "username",
                                    "value": "{{kcAdminUser}}"
                                },
                                {
                                    "key": "password",
                                    "value": "{{kcAdminPassword}}"
                                }
                            ]
                        },
                        "url": "https://localhost:8443/realms/master/protocol/openid-connect/token"
                    }
