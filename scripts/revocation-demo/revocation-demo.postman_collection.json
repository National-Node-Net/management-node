{
    "info": {
        "name": "Management Node - revocation demo",
        "description": "Generate -> sign -> status (OCSP) -> revoke -> status again. Full guide: scripts/revocation-demo/README.md. Before running: in Postman settings turn SSL certificate verification off, set the working directory to <repo>/scripts/revocation-demo/work, and add client certificates for localhost:8090 and localhost:8443 (<repo>/client.crt and client.key) and for 127.0.0.1:8090 (<repo>/scripts/revocation-demo/work/node.crt and node.key). Fill kcAdminUser / kcAdminPassword in the collection variables, then run folder 0.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "kcAdminUser",
            "value": ""
        },
        {
            "key": "kcAdminPassword",
            "value": ""
        },
        {
            "key": "kcAdminToken",
