        {
            "name": "1. Sign certificate",
            "description": "Before this folder, in the terminal: node_csr (writes node.key, node.csr and sign.json to scripts/revocation-demo/work and copies the request body to the clipboard). Paste it into the body of 1.2 Sign CSR.",
            "item": [
                {
                    "name": "1.1 Token FEDERATOR_ENV",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('envSecret is set (otherwise run folder 0. Setup)', function () { pm.expect(pm.collectionVariables.get('envSecret')).to.be.a('string').and.not.empty; });",
                                    "pm.test('200', function () { pm.response.to.have.status(200); });",
                                    "var token = pm.response.json().access_token;",
                                    "pm.collectionVariables.set('envToken', token);",
                                    "var p = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                                    "while (p.length % 4) p += '=';",
                                    "var claims = JSON.parse(atob(p));",
                                    "pm.test('roles: ' + claims.resource_access['management-node'].roles.join(', '), function () {});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "grant_type",
                                    "value": "client_credentials"
                                },
                                {
                                    "key": "client_id",
                                    "value": "FEDERATOR_ENV"
                                },
                                {
                                    "key": "client_secret",
                                    "value": "{{envSecret}}"
                                }
                            ]
                        },
                        "url": "https://localhost:8443/realms/mng-node/protocol/openid-connect/token"
                    }
                },
                {
                    "name": "1.2 Sign CSR",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 401) { pm.test('401: token expired or empty, send 1.1 again right before this request', function () { pm.expect.fail(); }); return; }",
                                    "if (pm.response.code === 400) { pm.test('400: paste the output of node_csr into the body', function () { pm.expect.fail(); }); return; }",
                                    "pm.test('200 signed', function () { pm.response.to.have.status(200); });",
                                    "var j = pm.response.json();",
                                    "pm.collectionVariables.set('serial', j.serialNumber);",
                                    "pm.test('serial = ' + j.serialNumber, function () {});",
                                    "pm.test('NEXT: run node_files in the terminal (writes node.crt and ocsp-req.der for this serial)', function () {});",
                                    "console.log(j.certificate);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{envToken}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"csr\": \"Run node_csr in the terminal, then replace this whole body with the clipboard (Ctrl+A, Ctrl+V)\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "https://localhost:8090/api/v1/certificate/csr/sign"
                    }
                }
            ]
        },
